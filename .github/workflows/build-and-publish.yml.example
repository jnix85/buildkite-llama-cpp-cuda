name: Build and publish llama-server

on:
  push:
    branches:
      - main
    tags:
      - "v*"
  pull_request:
  workflow_dispatch:
    inputs:
      llama_tag:
        description: "llama.cpp tag or branch to build"
        required: false
        default: "master"
        type: string

permissions:
  contents: read

env:
  DOCKER_BUILDKIT: "1"
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}
  LLAMA_TAG: ${{ inputs.llama_tag || 'master' }}

jobs:
  build-deb:
    name: Build Debian package
    runs-on: ubuntu-24.04
    steps:
      - name: Check out repository
        uses: actions/checkout@v5

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Check Buildx availability
        run: docker buildx version

      - name: Build Debian package
        run: |
          mkdir -p dist
          echo "--- Building llama.cpp tag: ${LLAMA_TAG} for Turing (CC 7.5)"
          LLAMA_TAG="${LLAMA_TAG}" docker buildx bake deb
          ls -la dist/

      - name: Upload Debian package
        uses: actions/upload-artifact@v4
        with:
          name: llama-server-cuda-deb-${{ github.sha }}
          path: dist/*.deb
          if-no-files-found: error
          retention-days: 30

  verify-deb:
    name: Verify Debian package
    needs: build-deb
    runs-on: ubuntu-24.04
    steps:
      - name: Download Debian package
        uses: actions/download-artifact@v5
        with:
          name: llama-server-cuda-deb-${{ github.sha }}
          path: dist

      - name: Inspect Debian package contents
        run: |
          dpkg -c dist/*.deb
          dpkg -I dist/*.deb

  publish-image:
    name: Publish image to GitHub Container Registry
    needs: verify-deb
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-24.04
    permissions:
      contents: read
      packages: write
    steps:
      - name: Check out repository
        uses: actions/checkout@v5

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Compute image tags
        id: image-tags
        shell: bash
        run: |
          image="${REGISTRY}/${IMAGE_NAME,,}"
          echo "image=${image}" >> "${GITHUB_OUTPUT}"
          echo "sha_tag=${image}:sha-${GITHUB_SHA}" >> "${GITHUB_OUTPUT}"
          if [[ "${GITHUB_REF_TYPE}" == "tag" ]]; then
            echo "release_tag=${image}:${GITHUB_REF_NAME#v}" >> "${GITHUB_OUTPUT}"
          fi
          if [[ "${GITHUB_REF_NAME}" == "main" ]]; then
            echo "latest_tag=${image}:latest" >> "${GITHUB_OUTPUT}"
          fi

      - name: Build and push runtime image
        shell: bash
        run: |
          tags="${{ steps.image-tags.outputs.sha_tag }}"
          if [[ -n "${{ steps.image-tags.outputs.release_tag }}" ]]; then
            tags+=",${{ steps.image-tags.outputs.release_tag }}"
          fi
          if [[ -n "${{ steps.image-tags.outputs.latest_tag }}" ]]; then
            tags+=",${{ steps.image-tags.outputs.latest_tag }}"
          fi
          docker buildx bake image \
            --push \
            --set "image.tags=${tags}" \
            --set "image.args.LLAMA_TAG=${LLAMA_TAG}"