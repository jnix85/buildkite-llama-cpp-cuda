[Unit]
Description=Automated llama.cpp Release Tracker and BuildKit Updater
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=osadmin
Group=osadmin
WorkingDirectory=/home/osadmin/src/apps/buildkite-llama-cpp-cuda
ExecStart=/home/osadmin/src/apps/buildkite-llama-cpp-cuda/scripts/auto-update-llama.sh
StandardOutput=journal
StandardError=journal
